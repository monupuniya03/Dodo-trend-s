<a href="upi://pay?pa=puniya.aman@axl&pn=Dodo%20Trends&cu=INR">

💳 UPI<br>
puniya.aman@axl

</a>

</div>

</section>


<!-- FOOTER -->

<footer>

<h2>DODO TRENDS</h2>

<p>
T-Shirts • Shirts • Jeans • All Clothing
</p>

<p>
© 2026 Dodo Trends
</p>

</footer>


<!-- WHATSAPP SCRIPT -->

<script>

function order(product,price){

let message =
"Hello Dodo Trends 👋%0A%0A"+
"I want to order:%0A"+
"Product: "+product+"%0A"+
"Price: ₹"+price+"%0A%0A"+
"Please tell me available sizes and delivery details.";

window.open(
"https://wa.me/917073710116?text="+message,
"_blank"
);

}

</script>

</body>
</html>