</div>

</div>


<!-- PRODUCT 4 -->

<div class="product">

<div class="product-img">
🔥
</div>

<div class="product-info">

<h3>New Arrival</h3>

<p class="price">
₹999
</p>

<button class="order"
onclick="order('New Arrival','999')">

ORDER ON WHATSAPP

</button>

</div>

</div>

</div>

</section>


<!-- PAYMENT -->

<section>

<div class="payment">

<h2>
💳 UPI PAYMENT
</h2>

<p>
Pay securely using UPI
</p>

<div class="upi">
puniya.aman@axl
</div>

<br>

<a class="pay"
href="upi://pay?pa=puniya.aman@axl&pn=Dodo%20Trends&cu=INR">

PAY NOW

</a>

</div>

</section>


<!-- CONTACT -->

<section id="contact">

<h2 class="title">
CONNECT WITH US
</h2>

<div class="contact">

<a href="https://instagram.com/monu_puniya03"
target="_blank">

📸 Instagram<br>
@monu_puniya03

</a>


<a href="https://wa.me/917073710116"
target="_blank">

