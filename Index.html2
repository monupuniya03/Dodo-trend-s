<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>DODO TRENDS | Fashion Store</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f5f5f5;
    color:#111;
}

/* HEADER */
header{
    background:#111;
    color:white;
    padding:12px 18px;
    position:sticky;
    top:0;
    z-index:1000;
}

.nav{
    max-width:1100px;
    margin:auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.brand{
    display:flex;
    align-items:center;
    gap:10px;
    font-size:22px;
    font-weight:bold;
}

.logo{
    width:50px;
    height:50px;
    border-radius:50%;
    object-fit:cover;
    border:2px solid white;
}

/* MENU */
nav a{
    color:white;
    text-decoration:none;
    margin-left:15px;
    font-size:14px;
}

/* HERO */
.hero{
    background:linear-gradient(135deg,#111,#444);
    color:white;
    text-align:center;
    padding:70px 20px;
}

.hero h1{
    font-size:48px;
    margin-bottom:15px;
}

.hero p{
    font-size:18px;
    color:#ddd;
}

.shop-btn{
    display:inline-block;
    margin-top:25px;
    padding:14px 28px;
    background:white;
    color:#111;
    border-radius:30px;
    text-decoration:none;
    font-weight:bold;
}

/* SECTION */
section{
    max-width:1100px;
    margin:45px auto;
    padding:0 18px;
}

.title{
    text-align:center;
    font-size:30px;
    margin-bottom:25px;
}

/* CATEGORIES */
.categories{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.category{
    background:white;
    padding:25px 10px;
    text-align:center;
    border-radius:15px;
    font-size:18px;
    font-weight:bold;
    box-shadow:0 3px 12px #ddd;
}

/* PRODUCTS */
.products{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
}

.product{
    background:white;
    border-radius:18px;
    overflow:hidden;
    box-shadow:0 3px 15px #ddd;
}

.product-img{
    height:220px;
    background:#ddd;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:70px;
}

.product-info{
    padding:15px;
}

.product-info h3{
    margin-bottom:7px;
}

.price{
    font-size:20px;
    font-weight:bold;
}

.order{
    display:block;
    width:100%;
    margin-top:12px;
    padding:12px;
    border:0;
    border-radius:10px;
    background:#111;
    color:white;
    font-weight:bold;
    cursor:pointer;
}

/* UPI */
.payment{
    background:#111;
    color:white;
    padding:30px;
    border-radius:20px;
    text-align:center;
}

.upi{
    margin:15px 0;
    padding:12px;
    background:#292929;
    border-radius:10px;
    display:inline-block;
}

.pay{
    display:inline-block;
    padding:13px 25px;
    background:white;
    color:#111;
    border-radius:10px;
    text-decoration:none;
    font-weight:bold;
}

/* CONTACT */
.contact{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:15px;
}

.contact a{
    background:white;
    padding:20px;
    border-radius:15px;
    text-align:center;
    text-decoration:none;
    color:#111;
    font-weight:bold;
    box-shadow:0 3px 12px #ddd;
}

/* FOOTER */
footer{
    background:#111;
    color:white;
    text-align:center;
    padding:30px;
    margin-top:50px;
}

/* MOBILE */
@media(max-width:700px){

    nav{
        display:none;
    }

    .hero h1{
        font-size:40px;
    }

    .categories{
        grid-template-columns:repeat(2,1fr);
    }

    .products{
        grid-template-columns:repeat(2,1fr);
    }

    .contact{
        grid-template-columns:1fr;
    }

}

@media(max-width:450px){

    .products{
        grid-template-columns:1fr;
    }

}
</style>
</head>

<body>

<!-- HEADER -->

<header>

<div class="nav">

<div class="brand">

<!-- Apni uploaded logo image ka naam logo.jpg rakho -->
<img src="logo.jpg" class="logo">

<span>DODO TRENDS</span>

</div>

<nav>
<a href="#shop">Shop</a>
<a href="#category">Categories</a>
<a href="#contact">Contact</a>
</nav>

</div>

</header>


<!-- HERO -->

<div class="hero">

<h1>DODO TRENDS</h1>

<p>Wear Your Style.</p>

<p>T-Shirts • Shirts • Jeans • All Clothing</p>

<a href="#shop" class="shop-btn">
SHOP NOW
</a>

</div>


<!-- CATEGORY -->

<section id="category">

<h2 class="title">
SHOP BY CATEGORY
</h2>

<div class="categories">

<div class="category">
👕<br>
T-Shirts
</div>

<div class="category">
👔<br>
Shirts
</div>

<div class="category">
👖<br>
